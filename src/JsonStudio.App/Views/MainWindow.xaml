<Window x:Class="JsonStudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JsonStudio.App.ViewModels"
        xmlns:v="clr-namespace:JsonStudio.App.Views"
        Title="{Binding Title}" Width="1360" Height="840" MinWidth="820" MinHeight="480"
        Icon="/Themes/JsonStudio.ico"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Fg.Text}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        AllowDrop="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <v:NullToVisibilityConverter x:Key="NullToVis" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="J" Modifiers="Ctrl" Command="{Binding ToggleJsonCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Toolbar band ===== -->
    <Border Grid.Row="0" Background="{DynamicResource Toolbar.Bg}" Padding="14,8,10,8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="NewButton" Style="{StaticResource ToolbarButton}" Focusable="False" ToolTip="New document">
            <TextBlock Text="New  ▾" />
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenCommand}" Focusable="False" ToolTip="Open (Ctrl+O)" Margin="2,0,0,0" Content="Open" />
          <Button x:Name="RecentButton" Style="{StaticResource ToolbarButton}" Focusable="False" ToolTip="Recent files" Padding="6,4" Margin="0,0,2,0" Content="▾" />
          <Button Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" Focusable="False" ToolTip="Save (Ctrl+S)" Content="Save" Margin="6,0,2,0" />
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveAsCommand}" Focusable="False" ToolTip="Save as (Ctrl+Shift+S)" Content="Save as…" />
          <Border Width="1" Margin="8,4" Background="{DynamicResource Toolbar.Hover}" />
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding UndoCommand}" Focusable="False" ToolTip="Undo (Ctrl+Z)" Content="↶  Undo" />
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding RedoCommand}" Focusable="False" ToolTip="Redo (Ctrl+Y)" Content="↷  Redo" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{}{ }" FontFamily="{DynamicResource Font.Mono}" FontWeight="Bold" FontSize="16"
                     Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="JSON Studio" FontFamily="{DynamicResource Font.Title}" FontWeight="SemiBold" FontSize="16"
                     Foreground="{DynamicResource Toolbar.Fg}" VerticalAlignment="Center" />
          <Border Width="1" Height="20" Margin="16,0" Background="{DynamicResource Toolbar.Hover}" />
          <Grid VerticalAlignment="Center">
            <!-- Click the file name to rename; the new name is used on the next Save. -->
            <Border x:Name="FileNameLabel" CornerRadius="4" Padding="6,3" Margin="-6,0,0,0" Cursor="IBeam" Background="Transparent">
              <Border.ToolTip>
                <ToolTip>
                  <StackPanel>
                    <TextBlock Text="{Binding FilePathText}" />
                    <TextBlock Text="Click to rename. The new name is used the next time you save." Opacity="0.7" Margin="0,2,0,0" />
                  </StackPanel>
                </ToolTip>
              </Border.ToolTip>
              <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource Toolbar.Fg}" FontSize="13.5" />
            </Border>
            <TextBox x:Name="FileNameBox" Visibility="Collapsed" MinWidth="200" FontSize="13.5" Margin="-6,0,0,0" Padding="4,2"
                     Background="{DynamicResource Toolbar.Hover}" Foreground="{DynamicResource Toolbar.Fg}"
                     CaretBrush="{DynamicResource Toolbar.Fg}" SelectionBrush="{DynamicResource Accent}"
                     BorderBrush="{DynamicResource Accent}" BorderThickness="1" VerticalContentAlignment="Center" />
          </Grid>
          <Ellipse Width="8" Height="8" Margin="8,1,0,0" Fill="{DynamicResource Accent}" VerticalAlignment="Center"
                   ToolTip="Unsaved changes" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
          <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource Toolbar.Hover}"
                  VerticalAlignment="Center" Visibility="{Binding IsSample, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Sample document" FontSize="11.5" Foreground="{DynamicResource Toolbar.Muted}" />
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Command bar ===== -->
    <Border Grid.Row="1" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,7">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Indent" Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Border Style="{StaticResource SegmentHost}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="Indent" Content="2 spaces" IsChecked="{Binding IndentIs2}" />
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="Indent" Content="4 spaces" IsChecked="{Binding IndentIs4}" />
              <RadioButton Style="{StaticResource SegmentButton}" GroupName="Indent" Content="Tabs" IsChecked="{Binding IndentIsTab}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="240">
            <TextBox x:Name="FindBox" Style="{StaticResource SearchBox}" Tag="Find keys and values (Ctrl+F)"
                     Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <TextBlock Text="⌕" FontSize="15" Foreground="{DynamicResource Fg.Faint}" Margin="8,0,0,1"
                       VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <TextBlock Text="{Binding FindCountText}" Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center"
                     Margin="8,0,12,0" MinWidth="64" />
          <Button Style="{StaticResource CmdButton}" Command="{Binding ExpandAllCommand}" Content="Expand all" Margin="0,0,6,0"
                  Visibility="{Binding IsTreeMode, Converter={StaticResource BoolToVis}}" Focusable="False" />
          <Button Style="{StaticResource CmdButton}" Command="{Binding CollapseAllCommand}" Content="Collapse all" Margin="0,0,6,0"
                  Visibility="{Binding IsTreeMode, Converter={StaticResource BoolToVis}}" Focusable="False" />
          <Button Style="{StaticResource CmdButton}" Command="{Binding SortCommand}" Content="Sort keys A–Z" Margin="0,0,6,0" Focusable="False"
                  ToolTip="Sort the keys of every object (natural number order)" />
          <Button Style="{StaticResource CmdButton}" Command="{Binding ToggleJsonCommand}" Content="{Binding ShowJsonText}" Focusable="False"
                  ToolTip="Show or hide the JSON code (Ctrl+J)" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== File changed on disk ===== -->
    <Border Grid.Row="2" Background="{DynamicResource Banner.Bg}" Padding="14,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
            Visibility="{Binding FileChangedOnDisk, Converter={StaticResource BoolToVis}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="This file changed on disk. Reload?" Foreground="{DynamicResource Banner.Fg}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource CmdButton}" Command="{Binding ReloadCommand}" Content="Reload" Margin="0,0,6,0" />
        <Button Style="{StaticResource CmdButton}" Command="{Binding DismissReloadCommand}" Content="Dismiss" />
      </StackPanel>
    </Border>

    <!-- ===== Work area ===== -->
    <Grid Grid.Row="3" x:Name="WorkGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="CodeColumn" Width="460" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Header}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
          <DockPanel>
            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2" Background="{DynamicResource Pill.Bg}" VerticalAlignment="Center">
              <TextBlock Text="{Binding NodeCountText}" FontSize="11.5" Foreground="{DynamicResource Fg.Muted}" />
            </Border>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Designer" FontFamily="{DynamicResource Font.Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="2,0,12,0" />
              <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" Content="Tables" IsChecked="{Binding IsTablesMode}" />
                  <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" Content="Tree" IsChecked="{Binding IsTreeMode}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid>
          <ContentControl x:Name="TablesHost" Focusable="False" />
          <ContentControl x:Name="TreeHost" Focusable="False" />
          <!-- Designer lock -->
          <Grid Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource Bg.Window}" Opacity="0.72" />
            <Border VerticalAlignment="Top" Margin="16" Padding="14,10" CornerRadius="8" Background="{DynamicResource Banner.Bg}"
                    BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Style="{StaticResource CmdButton}" Command="{Binding GoToErrorCommand}" Content="Go to the error" Margin="0,0,6,0" />
                  <Button Style="{StaticResource CmdButton}" Command="{Binding DiscardCodeCommand}" Content="Discard code edits" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="The code has an error, so the designer shows the last valid version." Foreground="{DynamicResource Banner.Fg}"
                             FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CodeErrorText}" Foreground="{DynamicResource Banner.Fg}" Opacity="0.85" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </DockPanel>

      <ContentControl Grid.Column="1" x:Name="CodeSplitterHost" Focusable="False" />
      <ContentControl Grid.Column="2" x:Name="CodeHost" Focusable="False" />

      <!-- Toast message -->
      <Border Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" MaxWidth="640"
              Padding="14,9,8,9" CornerRadius="8" Background="{DynamicResource Toolbar.Bg}"
              Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="✕" Padding="6,0" Height="22" Margin="10,0,0,0"
                  Command="{Binding DismissToastCommand}" Focusable="False" />
          <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Toolbar.Fg}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===== Status bar ===== -->
    <Border Grid.Row="4" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding NodeCountText}" Foreground="{DynamicResource Fg.Muted}" Margin="0,0,14,0" />
          <TextBlock Foreground="{DynamicResource Fg.Muted}" Margin="0,0,14,0">
            <Run Text="depth" /> <Run Text="{Binding Depth, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Fg.Muted}" Margin="0,0,14,0" />
          <TextBlock Text="{Binding FilePathText}" Foreground="{DynamicResource Fg.Faint}" MaxWidth="420" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding FilePathText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusPath}" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Key}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
          <Button Style="{StaticResource IconButton}" Command="{Binding CopyPathCommand}" Content="Copy path" FontSize="11.5"
                  Margin="8,0,0,0" Height="22" Focusable="False" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
