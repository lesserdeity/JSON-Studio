<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>JsonStudio.App</RootNamespace>
    <AssemblyName>JsonStudio</AssemblyName>
    <Product>JSON Studio</Product>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Themes\JsonStudio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JsonStudio.Core\JsonStudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Themes\JsonStudio.ico" />
  </ItemGroup>
</Project>
